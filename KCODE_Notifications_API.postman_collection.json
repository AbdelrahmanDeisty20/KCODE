{
  "info": {
    "_postman_id": "kcode-notifications-api-collection",
    "name": "KCODE Notifications API",
    "description": "Postman Collection for KCODE Notifications API endpoints including FCM Tokens, Fetching Notifications, Mark Read, Delete, Clear All, and Public General Notification Deletion by Device ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://kcodeskin.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_BEARER_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "FCM Tokens",
      "item": [
        {
          "name": "Store Guest FCM Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"YOUR_FCM_DEVICE_TOKEN_HERE\",\n  \"device_id\": \"device_unique_id_12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/fcm-token",
              "host": ["{{base_url}}"],
              "path": ["api", "fcm-token"]
            },
            "description": "Save FCM device token for guest user without authentication."
          }
        },
        {
          "name": "Store User FCM Token (Auth)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"YOUR_FCM_DEVICE_TOKEN_HERE\",\n  \"device_id\": \"device_unique_id_12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/fcm-token",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "fcm-token"]
            },
            "description": "Save FCM device token for authenticated user."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Public General Notifications (No Auth Required)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications/general?per_page=10&device_id=device_unique_id_12345",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications", "general"],
              "query": [
                { "key": "per_page", "value": "10" },
                { "key": "device_id", "value": "device_unique_id_12345", "description": "Optional device_id to exclude deleted general notifications" }
              ]
            },
            "description": "Fetch public general broadcast notifications (where user_id IS NULL). Pass device_id to exclude notifications deleted by this device."
          }
        },
        {
          "name": "Delete Single General Notification (By Device ID)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"device_unique_id_12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notifications/general/1",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications", "general", "1"]
            },
            "description": "Delete / hide a specific public general notification for a guest/device using device_id."
          }
        },
        {
          "name": "Clear All General Notifications (By Device ID)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"device_unique_id_12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notifications/general/clear-all",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications", "general", "clear-all"]
            },
            "description": "Delete / clear all public general notifications for a guest/device using device_id."
          }
        },
        {
          "name": "Get All User Notifications (Personal + General)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/notifications?per_page=10",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "notifications"],
              "query": [
                { "key": "per_page", "value": "10" }
              ]
            },
            "description": "Fetch all notifications for the authenticated user (Personal + General broadcast notifications with per-user status)."
          }
        },
        {
          "name": "Mark Single Notification as Read",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/notifications/1/read",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "notifications", "1", "read"]
            },
            "description": "Mark a specific notification (Personal or General) as read for the authenticated user."
          }
        },
        {
          "name": "Mark All Notifications as Read",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/notifications/read-all",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "notifications", "read-all"]
            },
            "description": "Mark all notifications (Personal + General) as read for the authenticated user."
          }
        },
        {
          "name": "Delete Single Notification (Auth User)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/notifications/1",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "notifications", "1"]
            },
            "description": "Delete / hide a specific notification for the authenticated user."
          }
        },
        {
          "name": "Clear All Notifications (Auth User)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/notifications/clear-all",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "notifications", "clear-all"]
            },
            "description": "Delete / clear all notifications for the authenticated user."
          }
        }
      ]
    }
  ]
}
